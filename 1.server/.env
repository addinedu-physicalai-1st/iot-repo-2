########################################################
#TonyNo Home Ubuntu PC DB 정보
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=trdbpw!1234
########################################################

########################################################
#각 사용자 테스트 환경에서 사용하는 DB 정보
########################################################

DB_NAME=smart_parking

# UDP 수신 포트 (ESP32 -> 서버 영상/데이터 전송)
UDP_HOST=0.0.0.0
UDP_PORT=9000

# 주차장 운영 상태 기본값 (true=운영중, false=운영종료)
OPERATION_MODE_ON=true

