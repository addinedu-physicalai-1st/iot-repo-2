SERVER_BASE_URL=http://127.0.0.1:8000
CLIENT_NAME=device-pc
device_no=DC-001

# device_client <-> esp32, esp32-cam-server 통신 포트 설정
# REST API 포트 설정
DEVICE_RESTAPI_PORT = 7070; #esp32, esp32-cam-server 통신 포트 -> 3.device_client 프로그램 RestApi 통신 포트
# TCP SOCKET 포트 설정
DEVICE_RESTAPI_PORT = 8080; #esp32, esp32-cam-server 통신 포트 -> 3.device_client 연결하는 포트 소켓통신
# LPR 카메라 서버 설정
LPR_CAMERA_SERVER_UDP_PORT=7080
#LPR_CAMERA_SERVER_REST_PORT=80

# Arduino 직렬 통신 설정
ARDUINO_PORT=/dev/ttyACM0
ARDUINO_BAUD=115200

# ESP32 UDP 수신 설정 (카메라)
#UDP_LISTEN_HOST=0.0.0.0
#UDP_LISTEN_PORT=7070

# ESP32 보드 TCP 연결 설정 (예시는 필요에 맞게 수정)
