SERVER_BASE_URL=http://127.0.0.1:8000
CLIENT_NAME=device-pc
device_no=DC-001

# Arduino 직렬 통신 설정
ARDUINO_PORT=/dev/ttyACM0
ARDUINO_BAUD=115200

# ESP32 UDP 수신 설정 (카메라)
UDP_LISTEN_HOST=0.0.0.0
UDP_LISTEN_PORT=7070

# ESP32 보드 TCP 연결 설정 (예시는 필요에 맞게 수정)
ESP32_1_HOST=192.168.0.201
ESP32_1_PORT=9001
ESP32_2_HOST=192.168.0.202
ESP32_2_PORT=9002

